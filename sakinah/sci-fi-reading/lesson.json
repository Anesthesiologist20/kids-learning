    {
      "id": "questions",
      "label": "Picture questions",
      "lines": [
        {
          "id": "story",
          "parts": [
            "You are going to read",
            "a sci-fi story."
          ]
        },
        {
          "id": "pictures",
          "parts": [
            "Look at the pictures",
            "on pages 62–65",
            "and answer the questions."
          ]
        },
